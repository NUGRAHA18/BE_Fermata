#   cp .env.example .env

# Every value below has a safe default in application.yml EXCEPT JWT_SECRET, which has none on
# purpose: the application refuses to start without one rather than using a shipped secret.

# Runtime
# dev enables mock messaging, the telemetry simulator and public API docs.
# jetson is the FERTIMATA Rev A deployment on the Jetson Orin Nano (local broker, strict commands).
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Database (PostgreSQL; Supabase-compatible)
DATABASE_URL=jdbc:postgresql://localhost:5432/smartmelon
DATABASE_USERNAME=smartmelon
DATABASE_PASSWORD=change-me
DATABASE_POOL_SIZE=10

# PostgreSQL Docker
POSTGRES_PORT=5432
POSTGRES_DB=smartmelon

# Supabase example - use the connection pooler host and require SSL:
# DATABASE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_USERNAME=postgres.<project-ref>
# DATABASE_PASSWORD=<supabase-database-password>

# Security
JWT_SECRET=
JWT_ISSUER=smartmelon-backend
JWT_ACCESS_TOKEN_TTL_MINUTES=60

# Origin of the Next.js PWA.
FRONTEND_URL=http://localhost:3000

# First-run operator account. Created only while the user table is empty.
BOOTSTRAP_ENABLED=true
BOOTSTRAP_OPERATOR_USERNAME=operator
BOOTSTRAP_OPERATOR_PASSWORD=change-me
BOOTSTRAP_OPERATOR_FULL_NAME=Field Operator

# Realtime
WEBSOCKET_ENDPOINT=/ws
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000
WEBSOCKET_REQUIRE_AUTHENTICATION=true

# MQTT
# false uses the in-memory loopback transport: the backend runs with no broker at all.
MQTT_ENABLED=false
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_CLIENT_ID=smartmelon-backend

#broker mqtt
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_QOS=1

# PROVISIONAL topic templates. {deviceId} is replaced with the device code.
# The convention is not locked with the hardware team; change it here and nowhere else.
MQTT_TOPIC_TELEMETRY=smartmelon/{deviceId}/telemetry
MQTT_TOPIC_STATUS=smartmelon/{deviceId}/status
MQTT_TOPIC_COMMAND=smartmelon/{deviceId}/command
MQTT_TOPIC_COMMAND_ACK=smartmelon/{deviceId}/command/ack
MQTT_TOPIC_AI=smartmelon/{deviceId}/ai
MQTT_TOPIC_ALERT=smartmelon/{deviceId}/alert

# Hardware catalog (devices, sensors, actuators and interlocks of one hardware revision).
# HARDWARE_CATALOG_LOCATION must be a real environment variable - it is read before this file.
#   HARDWARE_CATALOG_LOCATION=file:/etc/fertimata/hardware.yml
# Create-only sync at startup; existing rows are never modified.
HARDWARE_CATALOG_SYNC=true

# Actuator command safety (interlock lists live in the hardware catalog)
# Refuse activating commands for a device that is not ONLINE (the jetson profile defaults to true).
ACTUATOR_REFUSE_WHEN_DEVICE_OFFLINE=false
# Wire expiry for commands, e.g. 30s. Empty means no expiresAt field.
ACTUATOR_COMMAND_TTL=

# Device liveness (provisional - depends on the firmware heartbeat interval)
DEVICE_OFFLINE_TIMEOUT_SECONDS=120
DEVICE_LIVENESS_CHECK_INTERVAL_SECONDS=30
DEVICE_AUTO_REGISTER=true

# Telemetry ingestion policy
TELEMETRY_AUTO_REGISTER_SENSORS=true
TELEMETRY_MAX_CLOCK_SKEW_SECONDS=300
TELEMETRY_MAX_METRICS_PER_MESSAGE=64

# Development tooling (dev profile only)
# Devices and metric ranges for the simulator are in application-dev.yml and follow the catalog.
DEV_SIMULATOR_ENABLED=true
DEV_SIMULATOR_INTERVAL=10s

# Logging
# DEBUG, INFO, WARN or ERROR. No inline comment after the value: .env is a properties file and the
# comment would become part of the value, which stops every non-dev profile from starting.
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_MQTT=INFO
